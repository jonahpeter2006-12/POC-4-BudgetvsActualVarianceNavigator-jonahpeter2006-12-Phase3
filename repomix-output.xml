+
+OVERALL_TYPES = {
+    "cost_centre_comparison",
+    "department_comparison",
+    "expenditure_category_comparison",
+}
+
+MONTHLY_TYPES = {
+    "monthly_cost_centre_comparison",
+    "monthly_department_comparison",
+    "monthly_expenditure_category_comparison",
+}
+
+REQUIRED_FINDING_FIELDS = {
+    "result_id",
