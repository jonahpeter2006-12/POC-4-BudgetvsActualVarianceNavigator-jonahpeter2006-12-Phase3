      } catch (err) {
        if (!cancelled) {
          console.error('Dashboard loading error:', err);
          setError(err instanceof Error ? err.message : 'Unable to connect to the backend.');
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    loadDashboard();
    return () => {
      cancelled = true;
    };
  }, [selectedDepartment, selectedMonth]);

